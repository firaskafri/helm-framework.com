---
import { render } from 'astro:content';
import { loadRoles } from '../../lib/content';
import RoleGuide from '../../layouts/RoleGuide.astro';

export async function getStaticPaths() {
  const roles = await loadRoles();
  return roles.map((role) => ({
    params: { slug: role.id },
    props: { role },
  }));
}

const { role } = Astro.props;
const { Content, headings } = await render(role);
---

<RoleGuide slug={role.id} {...role.data} headings={headings}>
  <Content />
</RoleGuide>
