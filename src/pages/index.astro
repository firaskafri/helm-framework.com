---
import {
  SITE_FULL_NAME,
  SITE_NAME,
  SITE_UPDATED_AT,
  SITE_DESCRIPTION,
} from '../data/site';
import { PUBLIC_UPDATES, UPDATES_LAST_MODIFIED } from '../data/updates';
import { loadDocs, loadRoles } from '../lib/content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import PrincipleCard from '../components/PrincipleCard.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import Footer from '../components/Footer.astro';
import UpdateSummary from '../components/UpdateSummary.astro';
import '../styles/home.css';

const foundation = (await loadDocs()).find((doc) => doc.id === 'foundation');
if (!foundation?.data.principles)
  throw new Error('Foundation principles are required');
const roles = (await loadRoles()).sort((a, b) => a.data.order - b.data.order);
const lastModified = new Date(
  UPDATES_LAST_MODIFIED > SITE_UPDATED_AT
    ? UPDATES_LAST_MODIFIED
    : SITE_UPDATED_AT,
);
---

<Base
  title="Home"
  fullTitle={`${SITE_NAME} — ${SITE_FULL_NAME}`}
  description={SITE_DESCRIPTION}
  lastModified={lastModified}
>
  <Nav />
  <main id="main-content" class="helm-home">
    <div id="approach">
      <Hero
        title={SITE_NAME}
        subtitle="A practical framework for deciding how people and AI agents work together. Agree who does the work, who makes decisions, and who remains responsible."
      />
    </div>

    <section class="home-section" aria-labelledby="principles-title">
      <div class="home-heading">
        <div>
          <p class="home-label">Principles</p>
          <h2 id="principles-title">Six principles for working with agents</h2>
        </div>
        <a class="home-link" href="/foundation">
          Read all principles <ArrowIcon class="w-4 h-4" />
        </a>
      </div>
      <div class="principles-grid">
        {foundation.data.principles.map((principle) => (
          <PrincipleCard {...principle} />
        ))}
      </div>
    </section>

    <section
      class="home-section"
      id="guides"
      aria-label="Practitioner and leadership guidance"
    >
      <div class="guide-grid">
        <a class="guide-card" href="/practitioners#the-operating-loop">
          <p class="home-label">For practitioners</p>
          <h2>How we work with agents</h2>
          <ul>
            <li>Choose which tasks to give agents</li>
            <li>Set clear limits before work starts</li>
            <li>Plan, execute, verify, ship, and learn</li>
            <li>Check results before they are shared</li>
            <li>Keep people responsible for decisions</li>
          </ul>
          <span class="home-link">
            Read the Practitioner Guide <ArrowIcon class="w-4 h-4" />
          </span>
        </a>
        <a class="guide-card leadership-card" href="/leadership">
          <p class="home-label">For leaders</p>
          <h2>How we lead and support the team</h2>
          <ul>
            <li>Agree who owns goals, decisions, and review</li>
            <li>Make handoffs between teams clear</li>
            <li>Support people as responsibilities change</li>
            <li>Review quality, outcomes, and effort together</li>
            <li>Introduce new ways of working in small steps</li>
          </ul>
          <span class="home-link">
            Read the Leadership Guide <ArrowIcon class="w-4 h-4" />
          </span>
        </a>
      </div>
      <details class="work-example" id="work">
        <summary>In practice: who owns an agent-drafted proposal?</summary>
        <div class="example-content">
          <p class="home-label">Illustrative example</p>
          <p>
            The sales lead agrees the customer need, approved sources, and task
            limits. An agent drafts the proposal without permission to send it.
            Sales and delivery review pricing, dates, and commitments. The sales
            lead decides what to send and owns the follow-through.
          </p>
          <p>
            <strong>Accountable throughout: the sales lead.</strong> Delegating
            the draft does not delegate responsibility for the proposal.
            Feedback informs the next brief.
          </p>
          <a class="home-link" href="/practitioners#the-human-agent-boundary">
            Discuss the human-agent boundary <ArrowIcon class="w-4 h-4" />
          </a>
        </div>
      </details>
    </section>

    <section class="home-section" aria-label="Roles and shared skills">
      <div class="resource-card">
        <p class="home-label">Roles &amp; responsibilities</p>
        <h2>How responsibilities and skills change</h2>
        <p>
          Explore what people remain responsible for, where expertise is needed,
          and who checks the work. The current role guides focus on engineering
          and product. Leaders, operations, and HR teams can adapt them for
          conversations about responsibilities and learning.
        </p>
        <ul class="role-links" aria-label="Current role guides">
          {roles.map((role) => (
            <li>
              <a href={`/roles/${role.id}`}>{role.data.title}</a>
            </li>
          ))}
        </ul>
        <a class="home-link" href="/roles">
          Explore the role guides <ArrowIcon class="w-4 h-4" />
        </a>
        <div class="shared-skills" id="skills">
          <h3>Build shared skills across the team</h3>
          <p>
            Judgment, Communication, Evaluation, Ownership, and Learning.
            Practice guides include content, engineering, sales, and account
            management examples.
          </p>
          <a class="home-link" href="/competencies">
            Explore shared skills <ArrowIcon class="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="latest-updates">
      <div class="home-heading">
        <h2 id="latest-updates">Latest updates</h2>
        <a class="home-link" href="/updates">
          View all updates <ArrowIcon class="w-4 h-4" />
        </a>
      </div>
      <div class="guide-grid">
        {PUBLIC_UPDATES.slice(0, 2).map((update) => (
          <UpdateSummary update={update} />
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
