---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PublicationInfo from '../components/PublicationInfo.astro';
import { SITE_UPDATED_AT } from '../data/site';
interface Props {
  title: string;
  description: string;
  lastModified?: Date;
  showPublicationInfo?: boolean;
}
const {
  title,
  description,
  lastModified = new Date(SITE_UPDATED_AT),
  showPublicationInfo = true,
} = Astro.props;
---

<Base title={title} description={description} lastModified={lastModified}>
  <Nav />
  <main id="main-content" class="max-w-4xl mx-auto px-6 pt-28 pb-16 w-full">
    {showPublicationInfo && <PublicationInfo lastModified={lastModified} />}
    <article class:list={['prose', showPublicationInfo && 'mt-8']}>
      <slot />
    </article>
  </main>
  <Footer />
</Base>
