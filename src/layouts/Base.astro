---
import { SITE_NAME, SITE_AUTHOR, SITE_UPDATED_AT } from '../data/site';
import { FRAMEWORK_VERSION, FRAMEWORK_RELEASE_STATE } from '../data/framework';
import type { PublicationStatus } from '../data/framework';
import {
  serializeJsonLd,
  buildWebsiteJsonLd,
  buildWebPageJsonLd,
} from '../lib/jsonLd';
import { resolveSiteOrigin, resolveOgImage } from '../lib/resolveSiteOrigin';
import { markdownPath } from '../lib/markdownPath';
import {
  SOCIAL_IMAGE_PATH,
  SOCIAL_IMAGE_WIDTH,
  SOCIAL_IMAGE_HEIGHT,
  SOCIAL_IMAGE_ALT,
} from '../data/social';
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';

interface Props {
  title: string;
  description?: string;
  /** Override the computed `<title>`. Falls back to `${title} | ${SITE_NAME}`. */
  fullTitle?: string;
  /** Absolute URL or path under `public/` (e.g. `/og-default.png`). */
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  frameworkVersion?: string;
  publicationStatus?: PublicationStatus;
  createdAt?: Date;
  lastModified?: Date;
}

const {
  title,
  description = 'Practical guidance for teams deciding how people and AI agents work together.',
  fullTitle = `${title} | ${SITE_NAME}`,
  ogImage = SOCIAL_IMAGE_PATH,
  ogImageAlt = SOCIAL_IMAGE_ALT,
  ogImageWidth = SOCIAL_IMAGE_WIDTH,
  ogImageHeight = SOCIAL_IMAGE_HEIGHT,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  frameworkVersion = FRAMEWORK_VERSION,
  publicationStatus,
  createdAt,
  lastModified = new Date(SITE_UPDATED_AT),
} = Astro.props;

const siteOrigin = resolveSiteOrigin(Astro.site, Astro.url);
const canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = new URL(canonicalPath, siteOrigin).href;
const ogImageAbsolute = resolveOgImage(ogImage, siteOrigin);
const homeUrl = new URL('/', siteOrigin).href;
const markdownUrl = markdownPath(canonicalPath);

const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large';
const hasWebPage = jsonLd.some(
  (item) => item['@id'] === `${canonicalUrl}#webpage`,
);
const ldJsonBlocks = noindex
  ? []
  : [
      buildWebsiteJsonLd(homeUrl),
      ...(!hasWebPage
        ? [
            buildWebPageJsonLd({
              headline: title,
              description,
              url: canonicalUrl,
              homeUrl,
              version: frameworkVersion,
              datePublished: createdAt,
              dateModified: lastModified,
            }),
          ]
        : []),
      ...jsonLd,
    ].map(serializeJsonLd);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="robots" content={robotsContent} />
    {frameworkVersion && (
      <meta name="helm:framework-version" content={frameworkVersion} />
    )}
    <meta name="helm:release-state" content={FRAMEWORK_RELEASE_STATE} />
    {publicationStatus && (
      <meta name="helm:publication-status" content={publicationStatus} />
    )}
    {createdAt && (
      <meta
        property="article:published_time"
        content={createdAt.toISOString()}
      />
    )}
    {lastModified && (
      <meta
        property="article:modified_time"
        content={lastModified.toISOString()}
      />
    )}
    <!-- Matches @theme --color-cream in global.css (meta theme-color cannot use CSS variables) -->
    <meta name="theme-color" content="#FDFBF7" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    {!noindex && <link rel="describedby" href="/llms.txt" type="text/plain" />}
    {!noindex && (
      <link
        rel="alternate"
        href={markdownUrl}
        type="text/markdown"
        title={`${title} | Markdown`}
      />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME}: guides and roles`}
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME}: updates`}
      href="/updates/rss.xml"
    />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {ldJsonBlocks.map((raw) => (
      <script type="application/ld+json" set:html={raw}></script>
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="helm-skip-link">
      Skip to content
    </a>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
