---
import { SITE_NAME, SITE_AUTHOR, SITE_UPDATED_AT } from '../data/site';
import { FRAMEWORK_VERSION, FRAMEWORK_RELEASE_STATE } from '../data/framework';
import type { PublicationStatus } from '../data/framework';
import { serializeJsonLd } from '../lib/jsonLd';
import { resolveSiteOrigin, resolveOgImage } from '../lib/resolveSiteOrigin';

interface Props {
  title: string;
  description?: string;
  /** Override the computed `<title>`. Falls back to `${title} — ${SITE_NAME}`. */
  fullTitle?: string;
  /** Absolute URL or path under `public/` (e.g. `/og-default.png`). */
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  frameworkVersion?: string;
  publicationStatus?: PublicationStatus;
  createdAt?: Date;
  lastModified?: Date;
}

const {
  title,
  description = 'A framework for tech teams operating with AI agents.',
  fullTitle = `${title} — ${SITE_NAME}`,
  ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  frameworkVersion = FRAMEWORK_VERSION,
  publicationStatus,
  createdAt,
  lastModified = new Date(SITE_UPDATED_AT),
} = Astro.props;

const siteOrigin = resolveSiteOrigin(Astro.site, Astro.url);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageAbsolute = resolveOgImage(ogImage, siteOrigin);

const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow';
const ldJsonBlocks = jsonLd.map(serializeJsonLd);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="robots" content={robotsContent} />
    {frameworkVersion && (
      <meta name="helm:framework-version" content={frameworkVersion} />
    )}
    <meta name="helm:release-state" content={FRAMEWORK_RELEASE_STATE} />
    <meta name="helm:evidence-state" content="provisional-synthesis" />
    {publicationStatus && (
      <meta name="helm:publication-status" content={publicationStatus} />
    )}
    {createdAt && (
      <meta
        property="article:published_time"
        content={createdAt.toISOString()}
      />
    )}
    {lastModified && (
      <meta
        property="article:modified_time"
        content={lastModified.toISOString()}
      />
    )}
    <!-- Matches @theme --color-cream in global.css (meta theme-color cannot use CSS variables) -->
    <meta name="theme-color" content="#FDFBF7" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} — guides and roles`}
      href="/rss.xml"
    />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta
      property="og:image:alt"
      content="HELM — Human-first Execution and Leadership Model"
    />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Inter:wght@300..800&display=swap"
      rel="stylesheet"
    />

    {ldJsonBlocks.map((raw) => (
      <script type="application/ld+json" set:html={raw}></script>
    ))}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="helm-skip-link">
      Skip to content
    </a>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
