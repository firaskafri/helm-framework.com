---
import {
  SITE_NAME,
  SITE_AUTHOR,
  SITE_AUTHOR_URL,
  NAV_LINKS,
  REFERENCE_LINKS,
} from '../data/site';
import { FRAMEWORK_VERSION, FRAMEWORK_RELEASE_STATE } from '../data/framework';
import { statusLabel } from '../lib/updates';
---

<footer class="site-footer">
  <div class="footer-top">
    <div>
      <a class="wordmark" href="/">
        {SITE_NAME}
      </a>
      <p>
        Human-first Execution
        <br />
        and Leadership Model
      </p>
    </div>
    <div class="footer-navigation">
      <nav aria-label="Footer navigation">
        {NAV_LINKS.filter((link) => link.href !== '/').map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <nav aria-label="Framework information">
        {REFERENCE_LINKS.filter((link) => link.href !== '/updates').map(
          (link) => (
            <a href={link.href}>{link.label}</a>
          ),
        )}
        <a href="https://github.com/firaskafri/helm-framework.com">
          Contribute
        </a>
      </nav>
    </div>
  </div>
  <div class="footer-bottom">
    <a href="/changelog">
      HELM {FRAMEWORK_VERSION}
      {FRAMEWORK_RELEASE_STATE !== 'published' &&
        ` · ${statusLabel(FRAMEWORK_RELEASE_STATE)}`}
    </a>
    <span>Practical guidance for people and teams working with AI.</span>
    <span>
      &copy; {new Date().getFullYear()}{' '}
      <a href={SITE_AUTHOR_URL}>{SITE_AUTHOR}</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding: 38px 64px 28px;
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
  }
  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 40px;
  }
  .wordmark {
    font-size: 30px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.055em;
    text-decoration: none;
  }
  p {
    font-size: 12px;
    margin: 15px 0 0;
  }
  .footer-navigation {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
  }
  nav a {
    font-size: 12px;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
    margin-top: 35px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-size: 11px;
    color: var(--color-muted);
  }
  @media (max-width: 1100px) {
    .site-footer {
      padding-inline: 36px;
    }
  }
  @media (max-width: 760px) {
    .site-footer {
      padding-inline: 24px;
    }
    .footer-top {
      flex-direction: column;
      gap: 30px;
    }
    .footer-bottom {
      flex-wrap: wrap;
    }
  }
</style>
