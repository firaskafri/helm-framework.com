---
interface Props {
  principles: { id: string; number: number; title: string; quote: string }[];
}
const { principles } = Astro.props;
const examples = [
  'Use one clear brief before setting up a multi-agent workflow.',
  'Simplify an approval handoff before automating it.',
  'Name the person who will check the proposal and decide whether to send it.',
  'Give a drafting agent the approved sources it needs, without permission to publish. Instructions alone do not restrict access.',
  'Name an owner for one recurring decision, and make the handoff clear.',
  'Review one useful example together and choose a skill to practice.',
];
---

<section
  class="principles wrap"
  id="principles"
  aria-labelledby="principles-title"
>
  <p class="eyebrow section-label">The foundation</p>
  <div class="principles-heading">
    <h2 id="principles-title">
      Six principles for
      <br />
      shared working agreements.
    </h2>
    <p>
      Use these to discuss a real piece of work, make a choice, and agree what
      to try next.
    </p>
  </div>
  <div class="principles-grid">
    {principles.map((principle, i) => (
      <article class={`principle principle-${principle.number}`}>
        <span class="p-index">0{principle.number}</span>
        {i === 0 && (
          <span class="one-mark" aria-hidden="true">
            1
          </span>
        )}
        <div class="principle-copy">
          <h3>
            <a href={`/foundation#${principle.id}`}>{principle.title}</a>
          </h3>
          <p>{principle.quote}</p>
          {i === 1 && (
            <svg
              class="redesign-art"
              viewBox="0 0 440 70"
              role="img"
              aria-label="Simplify a four-step handoff into two useful steps"
            >
              <g fill="none" stroke="#8c7c91">
                <path d="M0 16h44v35H0ZM65 16h44v35H65ZM130 16h44v35h-44ZM195 16h44v35h-44Z" />
                <path d="M44 34h21m44 0h21m44 0h21" />
              </g>
              <path
                d="m64 13 47 42m-47 0 47-42m18 0 47 42m-47 0 47-42"
                stroke="#b62f1e"
                stroke-width="2"
              />
              <path d="M260 34h35m-7-7 8 7-8 7" fill="none" stroke="#2c2031" />
              <path d="M315 12h49v44h-49ZM388 12h49v44h-49Z" fill="#f36649" />
              <path d="M364 34h24" stroke="#2c2031" />
            </svg>
          )}
          <p class="example">
            <strong>Try this:</strong> {examples[i]}
          </p>
        </div>
        {i === 3 && (
          <svg class="guardrail-art" viewBox="0 0 220 125" aria-hidden="true">
            <path
              d="M12 14h196v96H12Z"
              fill="none"
              stroke="#2c2031"
              stroke-width="1.5"
            />
            <path
              d="M0 4h24M12 0v28M196 4h24m-12-4v28M0 120h24M12 97v28M196 120h24m-12-23v28"
              stroke="#2c2031"
              stroke-width="2"
            />
            <path
              d="M28 65h54l21-29 29 56 20-27h40"
              fill="none"
              stroke="#2c2031"
              stroke-width="2"
            />
            <circle cx="82" cy="65" r="5" fill="#2c2031" />
            <circle cx="152" cy="65" r="5" fill="#2c2031" />
          </svg>
        )}
      </article>
    ))}
  </div>
  <div class="principle-footer">
    <p>The examples above are illustrative starting points.</p>
    <a class="text-link" href="/foundation">
      Read the six principles in full{' '}
      <span class="arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  </div>
</section>
