---
import type { Update } from '../lib/updates';
import { statusLabel, updateUrl } from '../lib/updates';
interface Props {
  update: Update;
}
const { update } = Astro.props;
---

<article class="rounded-xl border border-[var(--color-border)] bg-white/60 p-6 md:p-8">
  <p class="text-sm text-[var(--color-muted)] mb-3 flex flex-wrap gap-x-3 gap-y-1">
    <time datetime={update.date}>{update.date}</time>
    <span>HELM {update.version}</span>
    <span class="font-semibold text-[var(--color-steel)]">
      {statusLabel(update.status)}
    </span>
  </p>
  <h3 class="font-serif text-xl font-semibold mb-3">
    <a href={updateUrl(update)} class="hover:text-[var(--color-terracotta)]">
      {update.title}
    </a>
  </h3>
  <p class="text-[var(--color-ink-light)] text-sm leading-relaxed mb-4">
    {update.summary}
  </p>
  <a
    href={updateUrl(update)}
    class="text-sm font-semibold text-[var(--color-terracotta)] underline underline-offset-4"
  >
    See what changed<span class="sr-only">: {update.title}</span>
  </a>
</article>
