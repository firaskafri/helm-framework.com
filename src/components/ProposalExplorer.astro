---
const stages = [
  {
    id: 'direction',
    label: 'Direction',
    eyebrow: 'Before the agent starts',
    title: 'A useful brief starts with a human choice.',
    person:
      'The customer’s need, a suitable offer, approved sources, and the limits of the task.',
    agent:
      'Uses the agreed brief. Flags missing information rather than filling gaps with promises.',
    artifactLabel: 'Shared brief / Sales → agent + reviewer',
    artifact:
      '“Draft a proposal for the customer’s stated needs. Use approved pricing. Mark the delivery date as unconfirmed.”',
  },
  {
    id: 'execution',
    label: 'Execution',
    eyebrow: 'Within agreed limits',
    title: 'Give the agent a task you can actually check.',
    person:
      'Access permissions, task boundaries, and a clear point for the agent to stop and ask.',
    agent:
      'Organizes the approved notes, drafts the proposal, and lists questions for the reviewer. It cannot send the proposal.',
    artifactLabel: 'Working draft / Agent → sales',
    artifact:
      'Customer needs → proposed scope → approved price → open questions. The sending tool is not available to the agent.',
  },
  {
    id: 'review',
    label: 'Review',
    eyebrow: 'Before anyone relies on it',
    title: 'A polished draft still needs a critical read.',
    person:
      'The sales lead checks customer fit and pricing. Delivery colleagues confirm what can be delivered, and when.',
    agent:
      'Points to supporting sources and revises the draft after feedback. Its own checks do not replace human review.',
    artifactLabel: 'Review request / Sales → delivery',
    artifact: '“Your team will be up and running in two weeks.”',
  },
  {
    id: 'accountability',
    label: 'Accountability',
    eyebrow: 'The decision stays human',
    title: 'Someone owns the promise. And the follow-through.',
    person:
      'The sales lead decides whether to send, records agreed commitments, and follows up on corrections and the handover.',
    agent:
      'Prepares a summary of the reviewed commitments. It does not approve the offer or make promises on the team’s behalf.',
    artifactLabel: 'Confirmed handover / Sales → delivery',
    artifact:
      'Agreed scope. Confirmed commitments. Named owners. Open questions. Share what the next person needs to know.',
  },
];
---

<section
  class="work"
  id="work"
  aria-labelledby="work-title"
  data-proposal-explorer
>
  <div class="wrap">
    <div class="work-header">
      <div>
        <p class="eyebrow section-label">Explore the handoffs</p>
        <h2 id="work-title">
          Follow a proposal
          <br />
          <span>across team boundaries.</span>
        </h2>
      </div>
      <p>
        Sales owns the customer conversation. Delivery must confirm the
        commitments. Explore how agent assistance fits between them, with a
        clear human decision owner.
      </p>
    </div>
    <div class="scenario-bar">
      <p>
        <strong>The situation:</strong> sales and delivery prepare a customer
        proposal
      </p>
      <span>Illustrative scenario · not a prescribed process</span>
    </div>
    <div
      class="stage-tabs"
      role="tablist"
      aria-label="Explore the proposal handoffs"
    >
      {stages.map((stage, i) => (
        <button
          class="stage-tab"
          id={`proposal-tab-${stage.id}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`proposal-panel-${stage.id}`}
          tabindex={i === 0 ? 0 : -1}
          data-stage={i}
        >
          <span>0{i + 1}</span>
          {stage.label}
        </button>
      ))}
    </div>
    <div class="work-body">
      <div class="work-visual">
        <svg
          viewBox="0 0 540 460"
          role="img"
          aria-labelledby="proposal-map-title proposal-map-desc"
        >
          <title id="proposal-map-title">A proposal moves through four handoffs</title>
          <desc id="proposal-map-desc">
            The sales lead sets direction. An agent prepares a draft. The sales
            lead reviews with delivery colleagues and decides what to send. The
            sales lead remains accountable throughout.
          </desc>
          <defs>
            <pattern
              id="proposal-dots"
              width="22"
              height="22"
              patternUnits="userSpaceOnUse"
            >
              <circle cx="1" cy="1" r=".8" fill="#8f7c99" opacity=".45" />
            </pattern>
          </defs>
          <path d="M0 0h540v460H0Z" fill="url(#proposal-dots)" />
          <path
            d="M148 110H400V340H148Z"
            fill="none"
            stroke="#83708c"
            stroke-width="2"
          />
          <path
            d="m266 105 8 5-8 5m129 102 5 8-5 8m-113 102-8 5 8 5m-129-112-5-8 5-8"
            fill="none"
            stroke="#e0ef89"
            stroke-width="2"
          />
          <g class="stage-node active" data-node="0">
            <circle cx="148" cy="110" r="47" fill="#e0ef89" />
            <path d="M131 110h34m-17-17v34" stroke="#2c2031" stroke-width="2" />
            <circle
              cx="148"
              cy="110"
              r="23"
              fill="none"
              stroke="#2c2031"
              stroke-width="1.5"
            />
            <text
              x="148"
              y="44"
              text-anchor="middle"
              fill="#f7f5ef"
              font-size="15"
              font-family="Arial"
            >
              01 / DIRECTION
            </text>
            <rect x="105" y="165" width="86" height="26" fill="#2c2031" />
            <text
              x="148"
              y="183"
              text-anchor="middle"
              fill="#e0ef89"
              font-size="14"
              font-family="Arial"
            >
              Sales lead
            </text>
          </g>
          <g class="stage-node" data-node="1">
            <path d="M360 69h80v82h-80Z" fill="#c5b4ed" />
            <path
              d="M379 93h41M379 108h31M379 123h36"
              stroke="#2c2031"
              stroke-width="2"
            />
            <text
              x="400"
              y="44"
              text-anchor="middle"
              fill="#f7f5ef"
              font-size="15"
              font-family="Arial"
            >
              02 / EXECUTION
            </text>
            <rect x="371" y="165" width="58" height="26" fill="#2c2031" />
            <text
              x="400"
              y="183"
              text-anchor="middle"
              fill="#c5b4ed"
              font-size="14"
              font-family="Arial"
            >
              Agent
            </text>
          </g>
          <g class="stage-node" data-node="2">
            <circle cx="400" cy="340" r="47" fill="#e0ef89" />
            <circle
              cx="396"
              cy="335"
              r="16"
              fill="none"
              stroke="#2c2031"
              stroke-width="2"
            />
            <path d="m408 347 14 14" stroke="#2c2031" stroke-width="2" />
            <text
              x="400"
              y="417"
              text-anchor="middle"
              fill="#f7f5ef"
              font-size="15"
              font-family="Arial"
            >
              03 / REVIEW
            </text>
            <rect x="330" y="253" width="140" height="29" fill="#2c2031" />
            <text
              x="400"
              y="275"
              text-anchor="middle"
              fill="#e0ef89"
              font-size="14"
              font-family="Arial"
            >
              Sales + delivery
            </text>
          </g>
          <g class="stage-node" data-node="3">
            <circle cx="148" cy="340" r="47" fill="#e0ef89" />
            <path
              d="m128 342 13 12 25-28"
              fill="none"
              stroke="#2c2031"
              stroke-width="2"
            />
            <text
              x="148"
              y="417"
              text-anchor="middle"
              fill="#f7f5ef"
              font-size="15"
              font-family="Arial"
            >
              04 / ACCOUNTABILITY
            </text>
            <rect x="105" y="253" width="86" height="29" fill="#2c2031" />
            <text
              x="148"
              y="275"
              text-anchor="middle"
              fill="#e0ef89"
              font-size="14"
              font-family="Arial"
            >
              Sales lead
            </text>
          </g>
          <g fill="#f7f5ef" text-anchor="middle">
            <text
              x="273"
              y="220"
              font-family="Georgia,serif"
              font-size="25"
              font-style="italic"
            >
              One proposal.
            </text>
            <text
              x="273"
              y="246"
              font-family="Arial"
              font-size="12"
              letter-spacing="1"
            >
              CLEAR RESPONSIBILITIES.
            </text>
          </g>
          <g class="active-ring" aria-hidden="true">
            <circle
              cx="148"
              cy="110"
              r="57"
              fill="none"
              stroke="#f36649"
              stroke-width="2"
            />
            <circle cx="148" cy="53" r="4" fill="#f36649" />
          </g>
        </svg>
      </div>
      <div class="work-details">
        {stages.map((stage, i) => (
          <div class="stage-panel" id={`proposal-panel-${stage.id}`}>
            <p class="eyebrow">
              0{i + 1} / {stage.eyebrow}
            </p>
            <h3>{stage.title}</h3>
            <dl class="ownership-list">
              <div class="ownership">
                <dt>Person owns</dt>
                <dd>{stage.person}</dd>
              </div>
              <div class="ownership agent">
                <dt>Agent does</dt>
                <dd>{stage.agent}</dd>
              </div>
            </dl>
            <div class="artifact">
              <span class="eyebrow">{stage.artifactLabel}</span>
              <p>{stage.artifact}</p>
              {stage.id === 'review' && (
                <details class="review-disclosure">
                  <summary>What should the reviewer question?</summary>
                  <p>
                    The date has not been confirmed. Ask the delivery owner,
                    then correct the wording or leave the timing explicitly open
                    before the proposal is sent.
                  </p>
                </details>
              )}
            </div>
          </div>
        ))}
        <button class="next-stage">
          <span>Next: execution</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
    <div class="accountability">
      <span class="owner-mark" aria-hidden="true">
        ↳
      </span>
      <p>
        <strong>Accountable throughout: the sales lead.</strong> Delegating the
        draft does not delegate responsibility for the proposal.
      </p>
    </div>
  </div>
</section>

<script>
  const explorer = document.querySelector<HTMLElement>(
    '[data-proposal-explorer]',
  );
  if (explorer) {
    const tabs = [
      ...explorer.querySelectorAll<HTMLButtonElement>('.stage-tab'),
    ];
    const panels = [...explorer.querySelectorAll<HTMLElement>('.stage-panel')];
    const nodes = [...explorer.querySelectorAll<SVGGElement>('.stage-node')];
    const ring = explorer.querySelector<SVGGElement>('.active-ring');
    const next = explorer.querySelector<HTMLButtonElement>('.next-stage');
    const positions = [
      [0, 0],
      [252, 0],
      [252, 230],
      [0, 230],
    ];
    const nextLabels = [
      'Next: execution',
      'Next: review',
      'Next: accountability',
      'Back to direction',
    ];
    let stage = 0;
    function selectStage(index: number, focusTab = false) {
      stage = index;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
        nodes[i].classList.toggle('active', i === index);
      });
      if (ring)
        ring.style.transform = `translate(${positions[index][0]}px, ${positions[index][1]}px)`;
      if (next?.firstElementChild)
        next.firstElementChild.textContent = nextLabels[index];
      if (focusTab) tabs[index].focus({ preventScroll: true });
    }
    panels.forEach((panel, i) => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[i].id);
      panel.tabIndex = 0;
    });
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => selectStage(i));
      tab.addEventListener('keydown', (event) => {
        const targets: Record<string, number> = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowLeft: (i + tabs.length - 1) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (event.key in targets) {
          event.preventDefault();
          selectStage(targets[event.key], true);
        }
      });
    });
    next?.addEventListener('click', () => {
      selectStage((stage + 1) % tabs.length);
      panels[stage].focus({ preventScroll: true });
    });
    selectStage(0);
    explorer.setAttribute('data-enhanced', 'true');
  }
</script>
