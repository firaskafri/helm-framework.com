---
import type { RoleView } from '../lib/competencyMap';
import { gapPercent } from '../lib/competencyMap';

interface Props {
  role: RoleView;
  index: number;
}

const { role, index } = Astro.props;
const gap = gapPercent(role);
const foundation = 100 - gap;
const accentVar =
  role.category === 'engineering' ? '--color-terracotta' : '--color-steel';
---

<div
  class="ce-role"
  role="tabpanel"
  id={role.id}
  aria-labelledby={`ce-tab-${role.id}`}
  data-role={role.id}
  hidden={index > 0}
>
  <div class="ce-header">
    <h2 class="ce-header-top">
      <div class="ce-header-from">
        <span class="ce-label">Role guide</span>
        <span class="ce-header-title">{role.fromTitle}</span>
        <span class="ce-header-aliases">{role.aliases.join(' \u00B7 ')}</span>
      </div>
      <div class="ce-header-arrow" aria-hidden="true">
        <svg
          width="40"
          height="40"
          viewBox="0 0 40 40"
          fill="none"
          aria-hidden="true"
        >
          <circle
            cx="20"
            cy="20"
            r="19"
            stroke={`var(${accentVar})`}
            stroke-width="1.5"
            stroke-dasharray="3 3"
            opacity="0.4"
          />
          <path
            d="M15 20H25M25 20L21 16M25 20L21 24"
            stroke={`var(${accentVar})`}
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
      <div class="ce-header-to">
        <span class="ce-label">HELM responsibilities</span>
        <span class="ce-header-title" style={`color:var(${accentVar})`}>
          {role.toTitle}
        </span>
      </div>
    </h2>
    <p class="ce-header-subtitle">{role.subtitle}</p>

    <div class="ce-stats">
      <div class="ce-stat">
        <span class="ce-stat-num ce-stat-evolved">{role.evolved.length}</span>
        <span class="ce-stat-label">Build on experience</span>
      </div>
      <div class="ce-stat">
        <span class="ce-stat-num ce-stat-gap">{role.gaps.length}</span>
        <span class="ce-stat-label">Additional skills</span>
      </div>
      <div class="ce-stat">
        <span class="ce-stat-num ce-stat-dep">{role.deprecated.length}</span>
        <span class="ce-stat-label">Discuss in context</span>
      </div>
    </div>

    <div class="ce-gap-wrap">
      <div class="ce-gap-labels">
        <span>Skills linked to prior experience</span>
        <span>Other skills in this guide</span>
      </div>
      <div class="ce-gap-bar">
        <div
          class="ce-gap-bar-fill ce-gap-bar-evolved"
          style={`width:${foundation}%`}
        ></div>
        <div
          class="ce-gap-bar-fill ce-gap-bar-new"
          style={`width:${gap}%`}
        ></div>
      </div>
      <div class="ce-gap-labels ce-gap-labels-pct">
        <span>{foundation}% of listed skills</span>
        <span>{gap}% of listed skills</span>
      </div>
    </div>

    <a href={`/roles/${role.slug}`} class="ce-jd-link">
      Read the role guide
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  </div>

  <div class="ce-section">
    <div class="ce-section-head">
      <span class="ce-section-badge ce-badge-evolved">Build on experience</span>
      <h3 class="ce-section-title">Experience you can build on</h3>
      <p class="ce-section-desc">
        These entries connect familiar experience with tasks in AI-assisted
        work. Use the examples to discuss what you know and what needs practice.
      </p>
    </div>
    <div class="ce-evo-list">
      {role.evolved.map((c, i) => (
        <article class="ce-evo-item" style={`animation-delay:${i * 60}ms`}>
          <div class="ce-evo-comparison">
            <div class="ce-evo-was">
              <span class="ce-evo-tag">Related experience</span>
              <span class="ce-evo-was-text">{c.was}</span>
            </div>
            <div class="ce-evo-arrow" aria-hidden="true">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </div>
            <div class="ce-evo-now">
              <span class="ce-evo-tag ce-evo-tag-now">Application</span>
              <span class="ce-evo-now-title">{c.now}</span>
            </div>
          </div>
          <p class="ce-evo-desc">{c.desc}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="ce-section">
    <div class="ce-section-head">
      <span class="ce-section-badge ce-badge-gap">Additional skills</span>
      <h3 class="ce-section-title">Other skills to discuss</h3>
      <p class="ce-section-desc">
        These skills may also help with the work. The guide does not assign them
        to a previous skill or assume they are new to you.
      </p>
    </div>
    <div class="ce-cards">
      {role.gaps.map((c, i) => (
        <article
          class="ce-card ce-card-gap"
          style={`animation-delay:${(role.evolved.length + i) * 60}ms`}
        >
          <div class="ce-card-gap-head">
            <span class="ce-card-gap-badge">PRACTICE</span>
            <span class="ce-card-now-title">{c.title}</span>
          </div>
          <p class="ce-card-now-desc">{c.desc}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="ce-section">
    <div class="ce-section-head">
      <span class="ce-section-badge ce-badge-dep">Discuss in context</span>
      <h3 class="ce-section-title">Signals that need more context</h3>
      <p class="ce-section-desc">
        These signals alone do not show how someone approaches the work. Discuss
        relevant examples, decisions and learning alongside them.
      </p>
    </div>
    <div class="ce-dep-list">
      {role.deprecated.map((d, i) => (
        <div
          class="ce-dep-item"
          style={`animation-delay:${(role.evolved.length + role.gaps.length + i) * 40}ms`}
        >
          <svg
            class="ce-dep-x"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
          <span>{d}</span>
        </div>
      ))}
    </div>
  </div>
</div>
