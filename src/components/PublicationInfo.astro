---
import { FRAMEWORK_VERSION } from '../data/framework';
import { statusLabel } from '../lib/updates';
import type { PublicationStatus } from '../data/framework';
interface Props {
  lastModified: Date;
  publicationStatus?: PublicationStatus;
  frameworkVersion?: string;
}
const {
  lastModified,
  publicationStatus = 'published',
  frameworkVersion = FRAMEWORK_VERSION,
} = Astro.props;
---

<div class="publication-info text-sm text-[var(--color-ink-light)] mt-6 border-t border-[var(--color-border)] pt-4">
  <p>
    <a href="/changelog">HELM {frameworkVersion}</a>
    {publicationStatus !== 'published' &&
      ` · ${statusLabel(publicationStatus)}`}{' '}
    · Updated{' '}
    <time datetime={lastModified.toISOString()}>
      {lastModified.toISOString().slice(0, 10)}
    </time>
  </p>
</div>
<style>
  a {
    color: var(--color-terracotta);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
