---
import { SITE_NAME, NAV_LINKS } from '../data/site';
import HelmMark from './HelmMark.astro';

const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = NAV_LINKS.map((link) => ({
  ...link,
  isActive:
    link.href === '/'
      ? normalizedPath === '/'
      : normalizedPath === link.href ||
        normalizedPath.startsWith(`${link.href}/`),
}));
---

<nav data-site-nav aria-label="Main navigation" class="site-nav">
  <div class="nav-inner">
    <a href="/" class="site-brand" aria-label="HELM home">
      <HelmMark class="brand-mark" />
      <span class="wordmark">{SITE_NAME}</span>
      <span class="brand-note">
        Human-first Execution
        <br />
        and Leadership Model
      </span>
    </a>
    <ul class="desktop-links">
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={link.isActive ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <button
      id="mobile-menu-btn"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      Menu <span aria-hidden="true">+</span>
    </button>
  </div>
  <div id="mobile-menu" class="hidden">
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={link.isActive ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  const button = document.querySelector<HTMLButtonElement>('#mobile-menu-btn');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  function setMenu(open: boolean, returnFocus = false) {
    menu?.classList.toggle('hidden', !open);
    button?.setAttribute('aria-expanded', String(open));
    const symbol = button?.querySelector('span');
    if (symbol) symbol.textContent = open ? '−' : '+';
    if (open) menu?.querySelector<HTMLAnchorElement>('a')?.focus();
    else if (returnFocus) button?.focus();
  }
  button?.addEventListener('click', () =>
    setMenu(button.getAttribute('aria-expanded') !== 'true', true),
  );
  document.addEventListener('keydown', (event) => {
    if (
      event.key === 'Escape' &&
      button?.getAttribute('aria-expanded') === 'true'
    )
      setMenu(false, true);
  });
  nav?.addEventListener('focusout', (event) => {
    if (
      event.relatedTarget instanceof Node &&
      !nav.contains(event.relatedTarget)
    )
      setMenu(false);
  });
  matchMedia('(min-width: 1024px)').addEventListener('change', () =>
    setMenu(false),
  );
  nav?.setAttribute('data-enhanced', 'true');
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    max-width: 1440px;
    padding: 0 64px;
    margin: auto;
    min-height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }
  .site-brand {
    display: flex;
    gap: 12px;
    align-items: center;
    text-decoration: none;
    color: var(--color-ink);
    flex-shrink: 0;
  }
  .site-brand :global(.brand-mark) {
    width: 36px;
    height: 36px;
  }
  .wordmark {
    font-size: 33px;
    font-weight: 800;
    letter-spacing: -0.055em;
    line-height: 1;
  }
  .brand-note {
    font-size: 10px;
    line-height: 1.35;
    border-left: 1px solid var(--color-border);
    padding-left: 20px;
    margin-left: 10px;
  }
  .desktop-links {
    display: flex;
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .desktop-links a {
    font-size: 13px;
    text-decoration: none;
    padding-block: 12px;
  }
  a:hover,
  a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 7px;
  }
  #mobile-menu-btn {
    display: none;
    background: transparent;
    border: 1px solid var(--color-ink);
    padding: 10px 14px;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  #mobile-menu-btn span {
    margin-left: 12px;
  }
  #mobile-menu {
    display: none;
  }
  @media (max-width: 1200px) {
    .brand-note {
      display: none;
    }
    .nav-inner {
      padding-inline: 36px;
    }
  }
  @media (max-width: 1023px) {
    .nav-inner {
      min-height: 80px;
      padding-inline: 24px;
    }
    .desktop-links {
      display: none;
    }
    .site-nav[data-enhanced] #mobile-menu-btn {
      display: block;
    }
    #mobile-menu:not(.hidden) {
      display: block;
    }
    #mobile-menu {
      border-top: 1px solid var(--color-border);
    }
    #mobile-menu ul {
      padding: 12px 24px 20px;
      margin: 0;
      list-style: none;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px 20px;
    }
    #mobile-menu a {
      display: block;
      padding-block: 10px;
      font-size: 14px;
      text-decoration: none;
    }
    #mobile-menu a:hover,
    #mobile-menu a[aria-current='page'] {
      text-decoration: underline;
    }
  }
  @media print {
    .site-nav {
      display: none;
    }
  }
</style>
