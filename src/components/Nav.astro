---
import { NAV_LINKS, SITE_NAME } from '../data/site';
import HelmMark from './HelmMark.astro';

const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = NAV_LINKS.map((link) => ({
  ...link,
  isActive:
    link.href === '/'
      ? normalizedPath === '/'
      : normalizedPath === link.href ||
        normalizedPath.startsWith(`${link.href}/`),
}));
---

<nav data-site-nav aria-label="Main navigation" class="site-nav">
  <div class="nav-inner">
    <div class="brand-group">
      <a href="/" class="site-brand" aria-label="HELM home">
        <HelmMark class="brand-mark" />
        {SITE_NAME}
      </a>
    </div>
    <ul class="desktop-links">
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={link.isActive ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <button
      id="mobile-menu-btn"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="menu-label">Menu</span>
      <svg class="menu-icon" viewBox="0 0 20 20" aria-hidden="true">
        <path class="menu-line-top" d="M3 7h14" />
        <path class="menu-line-bottom" d="M3 13h14" />
      </svg>
    </button>
  </div>
  <div id="mobile-menu" class="hidden">
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={link.isActive ? 'page' : undefined}>
            <span>{link.label}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M4 10h12m-5-5 5 5-5 5" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  const button = document.querySelector<HTMLButtonElement>('#mobile-menu-btn');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  function setMenu(open: boolean, returnFocus = false) {
    menu?.classList.toggle('hidden', !open);
    button?.setAttribute('aria-expanded', String(open));
    const label = button?.querySelector('.menu-label');
    if (label) label.textContent = open ? 'Close' : 'Menu';
    if (open) menu?.querySelector<HTMLAnchorElement>('a')?.focus();
    else if (returnFocus) button?.focus();
  }
  button?.addEventListener('click', () =>
    setMenu(button.getAttribute('aria-expanded') !== 'true', true),
  );
  document.addEventListener('keydown', (event) => {
    if (
      event.key === 'Escape' &&
      button?.getAttribute('aria-expanded') === 'true'
    )
      setMenu(false, true);
  });
  nav?.addEventListener('focusout', (event) => {
    if (
      event.relatedTarget instanceof Node &&
      !nav.contains(event.relatedTarget)
    )
      setMenu(false);
  });
  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Node && !nav?.contains(event.target))
      setMenu(false);
  });
  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a'))
      setMenu(false);
  });
  matchMedia('(min-width: 1024px)').addEventListener('change', () =>
    setMenu(false),
  );
  nav?.setAttribute('data-enhanced', 'true');
</script>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    max-width: 1152px;
    padding: 0 24px;
    margin: auto;
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand-group {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-shrink: 0;
  }
  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.3px;
    min-height: 44px;
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-ink);
    flex-shrink: 0;
  }
  .site-brand:hover,
  .site-brand:focus-visible {
    text-decoration: none;
  }
  .site-brand :global(.brand-mark) {
    display: block;
    width: 24px;
    height: 24px;
  }
  .desktop-links {
    display: flex;
    gap: 22px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .desktop-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-muted);
    text-decoration: none;
    padding: 10px 0;
    transition: color 150ms ease;
  }
  .desktop-links a:hover {
    color: var(--color-ink);
  }
  .desktop-links a[aria-current='page'] {
    color: var(--color-terracotta);
  }
  #mobile-menu-btn {
    display: none;
    background: transparent;
    color: var(--color-ink);
    border: 0;
    border-radius: 4px;
    min-height: 44px;
    min-width: 44px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 10px 12px;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 150ms ease;
  }
  #mobile-menu-btn:hover,
  #mobile-menu-btn[aria-expanded='true'] {
    background: var(--color-cream-dark);
  }
  .menu-icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .menu-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .menu-icon path {
    transform-origin: center;
    transition: transform 150ms ease;
  }
  [aria-expanded='true'] .menu-line-top {
    transform: translateY(3px) rotate(45deg);
  }
  [aria-expanded='true'] .menu-line-bottom {
    transform: translateY(-3px) rotate(-45deg);
  }
  #mobile-menu {
    display: none;
  }
  @media (max-width: 1023px) {
    .nav-inner {
      min-height: 64px;
      padding-inline: 24px;
    }
    .desktop-links {
      display: none;
    }
    .site-nav[data-enhanced] #mobile-menu-btn {
      display: inline-flex;
    }
    #mobile-menu:not(.hidden) {
      display: block;
    }
    #mobile-menu {
      border-top: 1px solid var(--color-border);
      max-height: calc(100svh - 64px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .site-nav:not([data-enhanced]) #mobile-menu {
      max-height: none;
    }
    #mobile-menu ul {
      padding: 12px 16px 16px;
      margin: 0;
      list-style: none;
      display: grid;
      grid-template-columns: 1fr;
      gap: 4px;
    }
    #mobile-menu a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 44px;
      padding: 12px;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.4;
      border-radius: 8px;
      color: var(--color-ink-light);
      text-decoration: none;
      transition: background-color 150ms ease;
    }
    #mobile-menu a:hover,
    #mobile-menu a[aria-current='page'] {
      color: var(--color-ink);
      background: var(--color-cream-dark);
    }
    #mobile-menu a[aria-current='page'] {
      box-shadow: inset 0 0 0 1px var(--color-border);
    }
    #mobile-menu a svg {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .desktop-links a,
    #mobile-menu-btn,
    .menu-icon path,
    #mobile-menu a {
      transition: none;
    }
  }
  @media print {
    .site-nav {
      display: none;
    }
  }
</style>
