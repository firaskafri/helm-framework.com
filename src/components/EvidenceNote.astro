---
import { readingNote } from '../data/reading-notes';
interface Props {
  claim: string;
}
const note = readingNote(Astro.props.claim);
---

<aside class="evidence-note" aria-label="Using this guidance">
  {note}
</aside>
<style>
  .evidence-note {
    font-size: 0.9rem;
    line-height: 1.6;
    padding: 1rem;
    margin: 1rem 0;
    border-left: 3px solid var(--color-steel);
    background: var(--color-cream-dark);
    border-radius: 0 6px 6px 0;
  }
</style>
